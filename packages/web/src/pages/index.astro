---
import { App } from "../app/App";
import "../styles/global.css";
---

<!doctype html>
<html lang="en" data-theme="marquee">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#0c0a08" />
		<!-- The saved theme before first paint (src/lib/theme.ts owns it afterwards). -->
		<script is:inline>
			(function () {
				var root = document.documentElement;
				try {
					var c = localStorage.getItem("reelix.theme") || "marquee";
					if (c === "auto") c = matchMedia("(prefers-color-scheme: light)").matches ? "paper" : "marquee";
					root.dataset.theme = c;
					// An installed theme: its base shows until its stylesheet arrives (src/lib/theme.ts).
					var base = c === "marquee" || c === "paper" ? null : localStorage.getItem("reelix.theme.base");
					if (base) root.dataset.base = base;
					var light = c === "paper" || base === "paper";
					root.style.colorScheme = light ? "light" : "dark";
					document.querySelector('meta[name="theme-color"]').setAttribute("content", light ? "#f5f1ea" : "#0c0a08");
					var l = localStorage.getItem("reelix.lang");
					if (l) root.lang = l === "zh" ? "zh-CN" : l;
				} catch (e) {}
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content="Reelix" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black" />
		<title>Reelix</title>
	</head>
	<body class="bg-background text-foreground antialiased">
		<App client:only="react" />
	</body>
</html>
