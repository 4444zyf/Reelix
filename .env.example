# Copy to .env and fill in. The pre-flight check (preflight/reelix-preflight.sh) prints these for your NAS.

# Which optional services to run here, comma-separated: magpie, qbittorrent, jackett, jellyfin.
# Leave out the ones you already run elsewhere.
COMPOSE_PROFILES=

# The ONE folder that holds both downloads and library (hard links do not cross mounts).
# It is /media in every container: downloads in /media/torrents, library in /media/library.
MEDIA_ROOT=/volume1/data

# qBittorrent's user and group. Reelix and qBittorrent must match for hard links.
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# Reelix: its page is http://<nas>:7878. REELIX_BIND=127.0.0.1 keeps it to the NAS itself.
REELIX_BIND=0.0.0.0
REELIX_PORT=7878
REELIX_DATA_DIR=./reelix-data

# Where Reelix finds each service. Inside this network use the service name, NOT localhost:
#   one started by this file:        http://qbittorrent:8080, http://jackett:9117, http://jellyfin:8096, http://magpie:3425
#   one you already run elsewhere:   its container name after joining its network (docker-compose.override.example.yml),
#                                    or the NAS's LAN address (http://192.168.1.10:8080),
#                                    or http://host.docker.internal:<port> for something on the NAS itself.
# Used at start only while the setting is empty; afterwards Settings decides.
QBITTORRENT_URL=http://qbittorrent:8080
JACKETT_URL=http://jackett:9117
JELLYFIN_URL=http://jellyfin:8096
MAGPIE_URL=http://magpie:3425

# The private network. MAGPIE_ALLOW_IPS is built from it; change both only if it clashes with yours.
REELIX_SUBNET=172.31.78.0/24

# magpie (profile "magpie")
MAGPIE_VERSION=0.1.4405
# Opens magpie's web page: http://<nas>:3430/?k=<this>. 16+ letters and digits. Make one: openssl rand -hex 16
# Left empty, magpie makes a new one at each start: docker compose logs magpie
MAGPIE_WEB_KEY=
# 127.0.0.1 keeps the page to the NAS itself (reach it through an SSH tunnel).
MAGPIE_WEB_BIND=0.0.0.0
MAGPIE_WEB_PORT=3430
MAGPIE_CONFIG_DIR=./magpie-config
# Who else may reach magpie besides Reelix's network. Its allow list covers its web page too, so put your
# home network here or your browser is refused at :3430. The gateway (3425) is not published, so this opens
# only the page (which needs MAGPIE_WEB_KEY) until you publish 3425 for other machines' agents.
MAGPIE_ALLOW_IPS_EXTRA=192.168.1.0/24

# qBittorrent, Jackett, Jellyfin (profiles of the same names): their pages on the NAS, and their data.
QBITTORRENT_WEB_PORT=8080
TORRENT_PORT=6881
QBITTORRENT_CONFIG_DIR=./qbittorrent-config
JACKETT_WEB_PORT=9117
JACKETT_CONFIG_DIR=./jackett-config
JELLYFIN_WEB_PORT=8096
JELLYFIN_CONFIG_DIR=./jellyfin-config
