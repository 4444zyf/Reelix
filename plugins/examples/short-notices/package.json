{
  "name": "reelix-plugin-short-notices",
  "version": "0.1.0",
  "description": "Reference plugin: shortens the text of notices sent to your devices.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "reelix-plugin"
  ],
  "peerDependencies": {
    "@reelix/plugin": "*"
  },
  "reelix": {
    "api": 0,
    "id": "short-notices",
    "entry": "./src/index.ts",
    "runtime": "in-process",
    "settings": "./settings.schema.json",
    "uses": {
      "hooks": [
        "notify.before@1"
      ]
    }
  }
}
