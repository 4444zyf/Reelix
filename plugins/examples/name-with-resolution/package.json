{
  "name": "reelix-plugin-name-with-resolution",
  "version": "0.1.0",
  "description": "Reference plugin: adds the resolution to the names of filed videos.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "reelix-plugin"
  ],
  "peerDependencies": {
    "@reelix/plugin": "*"
  },
  "reelix": {
    "api": 0,
    "id": "name-with-resolution",
    "entry": "./src/index.ts",
    "runtime": "in-process",
    "uses": {
      "hooks": [
        "organise.name@1"
      ]
    }
  }
}
