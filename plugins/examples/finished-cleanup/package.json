{
  "name": "reelix-plugin-finished-cleanup",
  "version": "0.1.0",
  "description": "Reference plugin: finds finished downloads seeded longer than you set and proposes removing them.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "reelix-plugin"
  ],
  "peerDependencies": {
    "@reelix/plugin": "*"
  },
  "reelix": {
    "api": 0,
    "id": "finished-cleanup",
    "entry": "./src/index.ts",
    "runtime": "in-process",
    "settings": "./settings.schema.json",
    "screen": {
      "entry": "./screen/index.html",
      "title": "Finished downloads"
    },
    "uses": {
      "operations": {
        "scan": "read",
        "propose": "write",
        "kinds": "read"
      },
      "tools": [
        "scan"
      ],
      "jobs": [
        "daily"
      ],
      "runs": [
        "download.remove"
      ],
      "inbox": true
    }
  }
}
