{
	"type": "object",
	"required": [
		"seeded_days",
		"delete_files",
		"kind",
		"schedule",
		"at_most"
	],
	"properties": {
		"seeded_days": {
			"type": "number",
			"default": 14,
			"minimum": 0,
			"maximum": 365
		},
		"delete_files": {
			"type": "boolean",
			"default": false
		},
		"kind": {
			"type": "string",
			"default": "all",
			"x-reelix-options-from": "kinds"
		},
		"schedule": {
			"anyOf": [
				{
					"type": "string",
					"const": "manual"
				},
				{
					"type": "string",
					"const": "daily"
				}
			],
			"default": "manual"
		},
		"at_most": {
			"type": "integer",
			"default": 20,
			"minimum": 1,
			"maximum": 50,
			"x-reelix-show-when": {
				"field": "schedule",
				"equals": "daily"
			}
		}
	},
	"x-reelix-buttons": [
		"scan"
	]
}
