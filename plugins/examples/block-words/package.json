{
  "name": "reelix-plugin-block-words",
  "version": "0.1.0",
  "description": "Reference plugin: hides releases whose name contains a word you list.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "reelix-plugin"
  ],
  "peerDependencies": {
    "@reelix/plugin": "*"
  },
  "reelix": {
    "api": 0,
    "id": "block-words",
    "entry": "./src/index.ts",
    "runtime": "in-process",
    "settings": "./settings.schema.json",
    "uses": {
      "hooks": [
        "release.filter@1"
      ]
    }
  }
}
