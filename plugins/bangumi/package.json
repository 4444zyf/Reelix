{
  "name": "reelix-plugin-bangumi",
  "version": "0.1.0",
  "description": "Anime facts from Bangumi: entries, episodes and air dates for lining up seasons, and what is airing now.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": ["reelix-plugin"],
  "peerDependencies": { "@reelix/plugin": "*" },
  "reelix": {
    "api": 0,
    "id": "bangumi",
    "entry": "./src/index.ts",
    "runtime": "in-process",
    "settings": "./settings.schema.json",
    "uses": {
      "provides": ["reelix:metadata.source@1", "reelix:trends.source@1"],
      "network": ["config:base_url"]
    }
  }
}
