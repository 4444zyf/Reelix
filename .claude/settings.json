{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/docs-sync.sh\"",
            "timeout": 30,
            "statusMessage": "Checking docs before commit/push"
          }
        ]
      }
    ]
  }
}
